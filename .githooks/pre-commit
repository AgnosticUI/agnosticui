#!/usr/bin/env bash
set +e
BAD_MATCHES=$(git grep -nE '(catalogId|Catalog ID|AGNOSTICUI_CATALOG_ID|EXPECTED_CATALOG_ID|agnosticui-catalog\.json).*https://agnosticui\.com' v2/ \
  | grep -v 'https://agnosticui\.com/a2ui/v1/catalog\.json')
set -e

if [ -n "$BAD_MATCHES" ]; then
  echo "ERROR: Truncated or invalid catalogId URL detected. All references must use https://agnosticui.com/a2ui/v1/catalog.json"
  echo "$BAD_MATCHES"
  exit 1
fi
