{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@agnosticui/a2ui-lit": ["./node_modules/@agnosticui/a2ui-lit"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "../shared"],
  "exclude": ["../shared/**/*.spec.ts", "../shared/**/*.mts"]
}
