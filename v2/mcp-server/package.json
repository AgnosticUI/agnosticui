{
  "name": "@agnosticui/mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol Server for AgnosticUI schemas, manifests, and design tokens",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:verbose": "AGNOSTICUI_VERBOSE=true npm run test",
    "test:watch": "vitest",
    "test:local": "npm run build && node test-mcp-local.js",
    "test:local:watch": "npm run build && OLLAMA_MODEL=llama3.2:latest node test-mcp-local.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agnosticui",
    "sdui",
    "design-tokens",
    "json-schema"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "ollama": "^0.6.4",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
